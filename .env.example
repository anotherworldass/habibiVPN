# ===== Habibi API =====
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MySQL
# 本地开发：docker compose 把 MySQL 映射到宿主机 3308
DATABASE_URL=mysql://habibi:habibi@127.0.0.1:3308/habibivpn
# 生产 Docker：API 使用 host 网络，继续写本机 3306
# DATABASE_URL=mysql://用户:密码@127.0.0.1:3306/habibivpn

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT (change in production)
JWT_USER_SECRET=dev-user-secret-change-me
JWT_ADMIN_SECRET=dev-admin-secret-change-me

# ===== WireRaw (server-side only) =====
# API host must include https://
WIRERAW_HOST=https://habibiapi.wireraw.com
WIRERAW_SUB_HOST=https://habibisub.wireraw.vip
WIRERAW_KEY_ID=wrid-xxxxxxxx
WIRERAW_KEY_SECRET=wrat_xxxxxxxx
WIRERAW_MERCHANT_ID=mp-xxxxxxxx
# Optional. Local VPN/Clash only — Node fetch ignores shell http_proxy.
# Do NOT set this in production (omit or leave empty → direct connect).
# WIRERAW_HTTP_PROXY=http://127.0.0.1:7897

# Bootstrap admin (created on first API boot if missing)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Public H5 origin (invite links)
WEB_PUBLIC_ORIGIN=http://localhost:3000
# Public callback origin reachable by payment providers / Telegram webhooks
API_PUBLIC_ORIGIN=http://localhost:3001
# Stable production secret used to encrypt merchant, Telegram bot and LLM API credentials
PAYMENT_CONFIG_ENCRYPTION_KEY=dev-payment-encryption-key-change-me
# Telegram Bot token 在 Admin「运营活动 → Telegram Bot」按项目配置，勿写进环境变量

# ===== Apple IAP (StoreKit 2 / ASN V2) =====
# Process-wide: mock = local smoke (accept mock: tickets); live = real JWS only.
# Production MUST be live. Do not move this onto a 马甲 — one API serves all packages.
APPLE_IAP_MODE=mock
# Deprecated / ignored: bundle is Admin「App 包名 / 马甲」packageName (iOS bundleId).
# APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ENV=Sandbox
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY=

# ===== Google Play Billing =====
# Same process-wide mock/live switch as Apple. Production MUST be live.
GOOGLE_IAP_MODE=mock
# Deprecated / ignored: packageName comes from the project's Android / Play 马甲.
# GOOGLE_IAP_PACKAGE_NAME=
# GOOGLE_IAP_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# forgot-password: omit in prod (no reset_code in response). Dev defaults to returning code.
# PASSWORD_RESET_DEV_RETURN_CODE=true

# bootstrap anti-abuse (in-memory IP/device burst + per-device daily new accounts)
BOOTSTRAP_IP_LIMIT_PER_MIN=30
BOOTSTRAP_DEVICE_NEW_PER_DAY=2
# BOOTSTRAP_REQUIRE_DEVICE_ID=true

# ===== H5 public (optional) =====
# 注意：NEXT_PUBLIC_* 由 docker-compose.prod.yml 的 build.args 在 next build 时内联，
# 改完必须重建镜像才生效：FORCE=1 bash scripts/deploy-prod.sh
NEXT_PUBLIC_SUPPORT_EMAIL=support@habibivpn.com
# Mini App 客服默认用当前 Bot：https://t.me/<username>（bind 后也会自动缓存）
# NEXT_PUBLIC_TG_BOT_USERNAME=YourBotUsername
# 若要覆盖为别的客服号再设：
# NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/titivpn_app_bot
# NEXT_PUBLIC_TWITTER_URL=https://x.com/titivpn_com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 官网 H5（TG Mini App 的「App 下载」会打开 {该地址}/download）。不要填 tg. 子域。
# 留空时 Mini App 会拿自己的域名去掉 tg. 前缀当官网，所以线上务必显式填。
# NEXT_PUBLIC_WEBSITE_URL=https://www.titivpn.com
# 只在下载页不在 {WEBSITE_URL}/download 时才需要填
# NEXT_PUBLIC_DOWNLOAD_URL=https://www.titivpn.com/download
